# Maintainer: HyperOS Team
pkgname=hyper-welcome
pkgver=0.1.0
pkgrel=1
pkgdesc="HyperOS first-boot welcome screen"
arch=('x86_64')
url="https://hyperos.org"
license=('GPL3')
depends=('python' 'python-pyside6')
makedepends=('python-build' 'python-installer' 'python-wheel')
source=()
sha256sums=('SKIP')

build() {
    cd "$startdir/src"
    python -m build --wheel --no-isolation
}

package() {
    cd "$startdir/src"
    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 "$startdir/data/hyper-welcome.desktop" \
        "$pkgdir/usr/share/applications/hyper-welcome.desktop"

    install -Dm644 "$startdir/data/hyperwelcome-user.service" \
        "$pkgdir/usr/lib/systemd/user/hyperwelcome.service"

    install -Dm644 "$startdir/assets/icons/hyper-welcome.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/hyper-welcome.svg"
}
