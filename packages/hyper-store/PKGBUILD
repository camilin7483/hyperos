# Maintainer: HyperOS Team <team@hyperos.org>
pkgname=hyper-store
pkgver=0.1.0
pkgrel=1
pkgdesc="HyperOS software center"
arch=('x86_64')
url="https://hyperos.org"
license=('GPL-3.0-or-later')
depends=('python' 'python-pyside6' 'hyperos-core')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source("hyper-store-0.1.0.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/src"
    python -m build --wheel --no-isolation
}

package() {
    cd "${srcdir}/src"
    python -m installer --destdir="${pkgdir}" dist/*.whl

    # Install desktop file
    install -Dm644 "${srcdir}/../data/hyper-store.desktop" "${pkgdir}/usr/share/applications/hyper-store.desktop"

    # Install icon
    install -Dm644 "${srcdir}/../assets/icons/hyper-store.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/hyper-store.svg"
}
